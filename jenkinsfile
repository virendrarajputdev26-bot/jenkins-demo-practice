pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building Python application'
                sh 'python3 app.py'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests'
                sh 'python3 test_app.py'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
